<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="mnaupariS3.Views.vRegistro"
             Title="vRegistro">

    <ContentPage.Resources>
        <Style TargetType="Button">
            <Setter Property="BackgroundColor" Value="Black"/>
            <Setter Property="TextColor" Value="White"/>
            <Setter Property="FontSize" Value="22"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="TextColor" Value="Purple"/>
        </Style>
    </ContentPage.Resources>
    <VerticalStackLayout
        Padding="15"
        Spacing="15">
        <Label 
            Text="REGISTRO"
            FontSize="20"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />

        <Entry x:Name="txtUsuarioNuevo"
               Placeholder="Ingresa el nuevo usuario"
               />
        <Entry x:Name="txContrasena"
               Placeholder="Ingresa la contraseña"
               />
        <Grid ColumnSpacing="17">
            <Grid.RowDefinitions>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
        </Grid>
        <Button x:Name="btnGuardarUsuario"
                Text="Guardar Usuario"
                 Style="{StaticResource Boton}"
                Clicked="btnGuardarUsuario_Clicked"
                Grid.Row="0"
                Grid.Column="0"
                />
        <Button x:Name="btnCancelar"
                Text="Cancelar"
                Clicked="btnCancelar_Clicked"
                Grid.Row="0"
                Grid.Column="1"
                />

    </VerticalStackLayout>
</ContentPage>