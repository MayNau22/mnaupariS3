<?xml version="1.0" encoding="utf-8" ?>
  
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="mnaupariS3.Views.vLogin"
             Title="vLogin">

    <ContentPage.Resources>
        <Style x:Key="styleLaber" TargetType="Label">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="TextColor" Value="Blue"/>
            <Setter Property="HorizontalTextAlignment" Value="Center"/>
            <Setter Property="BackgroundColor" Value="Beige"/>
        </Style>
        <Style x:Key="styleEntry" TargetType="Entry">
            <Setter Property="Background" Value="Blue"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="TextColor" Value="Coral"/>

        </Style>
    </ContentPage.Resources>
    <VerticalStackLayout
        Padding="20"
        Spacing="15"
        Background="RosyBrown">
        <Label 
             Text="INICIO DE SESIÓN"
             FontSize="20"
             VerticalOptions="Center" 
             HorizontalOptions="Center" />  

        <!--IMAGENES-->
        <Image Source="https://thumbs.dreamstime.com/b/login-icon-button-vector-illustration-isolated-white-background-127001787.jpg" 
            WidthRequest="150"/>

        <Grid HorizontalOptions="Center"
               VerticalOptions="Center"
               RowSpacing="10"
               ColumnSpacing="10">      
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Label Text="Usuario"
                    Style="{StaticResource styleLaber}"
                    FontSize="18"
                    Grid.Row="0"
                    Grid.Column="0"
            />
            <Entry x:Name="txtUsuario"
                Placeholder="Ingresa usuario"
                Style="{StaticResource styleLaber}"   
                Grid.Row="0"
                Grid.Column="1"
         />
            <Label Text="Contraseña"
                FontSize="18"
                Style="{StaticResource styleLaber}"   
                Grid.Row="1"
                Grid.Column="0"
         />
            <Entry x:Name="txtContrasena"
                Placeholder="Ingresa contraseña"
                IsPassword="True"
                Style="{StaticResource styleLaber}"   
                Grid.Row="1"
                Grid.Column="1"
         />
            <Button x:Name="btnIniciarSesion"
                 Text="Iniciar Sesion"
                 Clicked="btnIniciarSesion_Clicked"
                 Grid.Row="2"
                 Grid.Column="0"
         />
            <Button x:Name="btnRegistrarUsuario" 
                 Text="Registrar Usuario"
                 Clicked="btnRegistrarUsuario_Clicked"
                 Grid.Row="2"
                 Grid.Column="1"
         />

        </Grid>

    </VerticalStackLayout>
</ContentPage>